# JobPacket environment variables.
# Copy this file to ".env.local" (which is gitignored) and fill in your values.
# Next.js loads .env.local automatically — restart the dev server after editing.

# Adzuna — broad India job listings via a stable API (no scraping).
# Get a free key at https://developer.adzuna.com/  (sign up → create an app).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional — override the Python used for the JobSpy scrapers (default: python3 / python).
# JOBPACKET_PYTHON=python3

# Optional — point at a non-default Ollama server.
# OLLAMA_HOST=http://localhost:11434

# Optional — override where the local packet DB lives (default: ~/.jobpacket/jobpacket.db).
# JOBPACKET_DB_PATH=/custom/path/jobpacket.db
